{
  "hosting": {
    "public": "docs",
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "**",
        "destination": "/404.html"
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "docs/js/admin_panel.js",
      "docs/css/admin_panel.css",
      "admin_panel.html",
      "template.html"
    ]
  }
}
