{
  "hosting": {
    "public": "docs",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "docs/js/admin_panel.js",
      "docs/css/admin_panel.css",
      "admin_panel.html",
      "template.html"
    ],

    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|gif|png|bmp|svg|webp)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=31536000"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=0"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/TicketBus",
        "destination": "https://aryanranderiya.com/Project?id=2_project_TicketBus_1705162807451",
        "type": 301
      },
      {
        "source": "/SpotifyTools",
        "destination": "https://aryanranderiya.com/Project.html?id=3_project_Spotify_Tools_1705162766118",
        "type": 301
      },
      {
        "source": "/contact",
        "destination": "/Contact",
        "type": 301
      },
      {
        "source": "/designprojects",
        "destination": "/DesignProjects",
        "type": 301
      },
      {
        "source": "/softwareprojects",
        "destination": "/SoftwareProjects",
        "type": 301
      },
      {
        "source": "/resume",
        "destination": "/Resume",
        "type": 301
      }
    ]
  }
}
