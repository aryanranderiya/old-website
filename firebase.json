{
  "hosting": {
    "public": "docs",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "docs/js/admin_panel.js",
      "docs/css/admin_panel.css",
      "admin_panel.html",
      "template.html"
    ],

    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=31536000"
          }
        ]
      }
    ]
  }
}
