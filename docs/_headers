/*
  X-Content-Type-Options: nosniff
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://js.hcaptcha.com https://newassets.hcaptcha.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.hcaptcha.com; font-src 'self'; media-src 'self' blob:; connect-src 'self' https://api.web3forms.com https://*.hcaptcha.com; frame-src 'self' https://*.hcaptcha.com; object-src 'self'; base-uri 'self'; form-action 'self' https://api.web3forms.com
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Cache-Control: public, max-age=0, must-revalidate

/media/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: no-cache

/js/*
  Cache-Control: no-cache

/packages/*
  Cache-Control: public, max-age=31536000, immutable
