{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "old-portfolio",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./docs",
    "html_handling": "none",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "old.aryanranderiya.com/*",
      "zone_name": "aryanranderiya.com"
    },
    {
      "pattern": "old2.aryanranderiya.com/*",
      "zone_name": "aryanranderiya.com"
    }
  ]
}
