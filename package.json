{
  "scripts": {
    "start": "lite-server",
    "build": "npx tailwindcss -i docs/css/index.css -o docs/css/index_output2.css --watch --minify",
    "build2": "npx tailwindcss -i docs/css/software_projects.css -o docs/css/software_projects2.css --watch --minify",
    "minjs": "npx terser-glob docs/js/*.js --compress --mangle --output build/js",
    "mincss": "cleancss -O2 --batch --batch-suffix '.min' docs/css/*.css -o build/css/",
    "test": "cleancss --batch --batch-suffix '.min' --rename --advanced --o build/css/ docs/css/*.css"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "css-loader": "^7.1.2",
    "cssnano": "^7.0.6",
    "csso": "^5.0.5",
    "lite-server": "^2.6.1",
    "postcss": "^8.4.49",
    "style-loader": "^4.0.0",
    "tailwindcss": "^3.4.17",
    "terser": "^5.37.0",
    "terser-glob": "^1.1.0",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1"
  }
}
