{
  "name": "old-website",
  "private": true,
  "description": "Archived 2025 portfolio, served as a self-contained static bundle",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "node scripts/check-archive.mjs",
    "check:strict": "node scripts/check-archive.mjs --strict",
    "vendor": "node scripts/vendor-externals.mjs",
    "media": "python3 scripts/sync-project-media.py",
    "fonts": "python3 scripts/optimize-fonts.py",
    "icons": "python3 scripts/build-icon-font.py"
  },
  "devDependencies": {
    "wrangler": "^4.166.0"
  }
}
