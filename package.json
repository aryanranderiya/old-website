{
  "scripts": {
    "start": "lite-server",
    "build": "npx tailwindcss -i docs/css/index.css -o docs/css/index_output2.css --watch --minify",
    "build2": "npx tailwindcss -i docs/css/software_projects.css -o docs/css/software_projects2.css --watch --minify",
    "minjs": "npx terser-glob docs/js/*.js --compress --mangle --output build/js",
    "mincss": "cleancss -O2 --batch --batch-suffix '.min' docs/css/*.css -o build/css/",
    "test": "cleancss --batch --batch-suffix '.min' --rename --advanced --o build/css/ docs/css/*.css",
    "postcss": "postcss build/**/*.css --dir build/css",
    "sitemap": "node scripts/generate-sitemap.js",
    "predeploy": "npm run sitemap",
    "deploy": "firebase deploy",
    "deploy:hosting": "npm run sitemap && firebase deploy --only hosting"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "lite-server": "^2.6.1",
    "postcss": "^8.5.1",
    "postcss-obfuscator": "^1.6.1",
    "tailwindcss": "^3.4.17",
    "terser": "^5.37.0",
    "terser-glob": "^1.1.0"
  },
  "packageManager": "pnpm@10.7.1+sha512.2d92c86b7928dc8284f53494fb4201f983da65f0fb4f0d40baafa5cf628fa31dae3e5968f12466f17df7e97310e30f343a648baea1b9b350685dafafffdf5808"
}
