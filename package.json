{
  "scripts": {
    "start": "lite-server",
    "build": "npx tailwindcss -i docs/css/index.css -o docs/css/index_output2.css --watch --minify",
    "build2": "npx tailwindcss -i docs/css/software_projects.css -o docs/css/software_projects2.css --watch --minify",
    "minjs": "npx terser-glob docs/js/*.js --compress --mangle --output build/js",
    "mincss": "cleancss -O2 --batch --batch-suffix '.min' docs/css/*.css -o build/css/",
    "test": "cleancss --batch --batch-suffix '.min' --rename --advanced --o build/css/ docs/css/*.css",
    "b": "webpack --mode production"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "autoprefixer": "^10.4.20",
    "babel-loader": "^9.2.1",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.0",
    "cssnano": "^7.0.6",
    "csso": "^5.0.5",
    "html-minimizer-webpack-plugin": "^5.0.0",
    "html-webpack-plugin": "^5.6.3",
    "lite-server": "^2.6.1",
    "mini-css-extract-plugin": "^2.9.2",
    "postcss": "^8.5.1",
    "postcss-loader": "^8.1.1",
    "postcss-modules": "^6.0.1",
    "postcss-obfuscator": "^1.6.1",
    "style-loader": "^4.0.0",
    "tailwindcss": "^3.4.17",
    "terser": "^5.37.0",
    "terser-glob": "^1.1.0",
    "terser-webpack-plugin": "^5.3.11",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0"
  }
}
